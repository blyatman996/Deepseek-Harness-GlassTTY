{
  "name": "dsh-glass-tty",
  "version": "0.1.0",
  "description": "GlassTTY：把 DSH 变成 1970 年代玻璃终端/笨终端风格的全屏 CRT 插件。",
  "private": false,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE",
    "LICENSES"
  ],
  "license": "BSD-3-Clause",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "author": "blyatman996",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blyatman996/Deepseek-Harness-GlassTTY.git"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "glass-tty",
    "terminal",
    "crt",
    "plugin",
    "retro"
  ],
  "publishConfig": {
    "access": "public"
  }
}
